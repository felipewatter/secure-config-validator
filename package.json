{
  "name": "secure-config-validator",
  "version": "1.1.0",
  "description": "Offline, privacy-safe validation of .env, JSON and YAML security configurations",
  "license": "MIT",
  "author": "Felipe Watter",
  "type": "commonjs",
  "engines": {"node": ">=22"},
  "bin": {"secure-config-validator": "./dist/bin/index.js"},
  "main": "./dist/src/validator.js",
  "types": "./dist/src/validator.d.ts",
  "files": ["dist", "README.md", "SECURITY.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "start": "node dist/bin/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {"yaml": "^2.8.1"},
  "devDependencies": {"@types/node": "^22.15.0", "typescript": "~5.9.3"}
}
